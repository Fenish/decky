{
    "name": "decky",
    "version": "0.2.0",
    "description": "Decky — your personal touch control surface",
    "repository": "github:Fenish/decky",
    "main": "out/main/index.js",
    "scripts": {
        "dev": "node scripts/ensure-electron.mjs && electron-vite dev",
        "build": "npm run typecheck && electron-vite build",
        "preview": "node scripts/ensure-electron.mjs && electron-vite preview",
        "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "package": "npm run build && electron-builder --win dir",
        "dist": "npm run build && electron-builder --win nsis",
        "test:ui": "npm run build && node scripts/ui-check.mjs",
        "test:visual": "npm run build && node scripts/visual-check.mjs",
        "test:connection": "npm run build && node scripts/disconnected-check.mjs"
    },
    "dependencies": {
        "electron-updater": "^6.8.9",
        "esptool-js": "0.6.1",
        "serialport": "^12.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@playwright/test": "1.61.1",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/three": "^0.185.4",
        "@types/w3c-web-serial": "^1.0.8",
        "@vitejs/plugin-react": "^5.2.0",
        "electron": "^44.3.0",
        "electron-builder": "^26.15.3",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "lucide-react": "^1.43.0",
        "prettier": "^3.9.6",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "three": "^0.186.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^7.3.6",
        "vite-plugin-svgr": "^5.2.0",
        "vitest": "^3.2.7"
    },
    "packageManager": "pnpm@10.0.0",
    "pnpm": {
        "onlyBuiltDependencies": [
            "@serialport/bindings-cpp",
            "electron",
            "esbuild"
        ]
    },
    "author": "Decky",
    "build": {
        "appId": "app.decky.desktop",
        "productName": "Decky",
        "directories": {
            "output": "dist"
        },
        "files": [
            "out/**/*",
            "package.json",
            "resources/**/*"
        ],
        "asar": true,
        "publish": [
            {
                "provider": "github"
            }
        ],
        "win": {
            "target": "nsis",
            "icon": "resources/icon.ico"
        },
        "nsis": {
            "artifactName": "Decky-Setup-${version}.${ext}",
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "shortcutName": "Decky"
        }
    },
    "engines": {
        "node": ">=22.16.0"
    }
}
